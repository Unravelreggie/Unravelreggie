{
  "name": "unravel-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/materialize-assets.mjs",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && vite build && node scripts/prepare-sites-build.mjs",
    "build:cloudflare": "npm run prepare:assets && vite build",
    "build:vercel": "npm run prepare:assets && vite build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy dist/client --project-name unravel-xiaoyuan",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.113.0"
  }
}
